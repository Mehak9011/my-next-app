# ============================================================
# CodeXmattriX — Headless WordPress + Next.js
# Copy this file to `.env.local` for local development and fill
# in real values. NEVER commit `.env.local` (it is gitignored).
# On Vercel, add the same variables in Project → Settings → Environment Variables.
# ============================================================

# --- Application ---
# App name shown in the browser/UI (client-side: must be NEXT_PUBLIC_)
NEXT_PUBLIC_APP_NAME=CodeXmattriX

# Canonical site URL. Used for metadata/SEO and assets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp floating button (digits only, country code first, no "+")
NEXT_PUBLIC_WHATSAPP_NUMBER=917832820005

# --- WordPress (headless CMS) ---
# Master switch for the WordPress data layer. Keep `false` for a
# fully self-contained build (falls back to bundled default content).
WORDPRESS_ENABLED=false

# WPGraphQL endpoint (install the WPGraphQL plugin on WordPress).
# Example: https://cms.example.com/graphql
WORDPRESS_GRAPHQL_URL=

# WordPress REST API base URL.
# Example: https://cms.example.com/wp-json
WORDPRESS_REST_URL=

# OPTIONAL — Application Password for authenticated REST/GraphQL calls
# (Users → Profile → Application Passwords). Only needed if you allow
# clients to create content through this Next.js app.
WORDPRESS_AUTH_USER=
WORDPRESS_APPLICATION_PASSWORD=

# OPTIONAL — request timeout for CMS calls in milliseconds.
WORDPRESS_TIMEOUT_MS=8000