# ============================================================
# CodeXmattriX — Headless WordPress + Next.js
# ------------------------------------------------------------
# Copy this file to `.env.local` for local development and fill in
# real values. NEVER commit `.env.local` (it is gitignored).
# On Vercel add the same variables in:
#   Project -> Settings -> Environment Variables  (then redeploy).
#
# Architecture: 100% of the frontend lives in Next.js.
# WordPress is used ONLY as the CMS that registers the pages/URLs
# via WPGraphQL. NO ACF, NO Elementor, NO page builder.
# ============================================================

# --- Application ---
# App name shown in the browser/UI (client-side: must be NEXT_PUBLIC_)
NEXT_PUBLIC_APP_NAME=CodeXmattriX

# Canonical site URL. Used for metadata/SEO and assets.
# Local dev -> http://localhost:3000
# Vercel (Production) -> https://my-next-app-phi-flax.vercel.app  (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp floating button + contact form (digits only, country code first)
NEXT_PUBLIC_WHATSAPP_NUMBER=917832820005

# --- WordPress (headless CMS - page/URL registry only) ---
# Master switch. `true` lets Next.js read the WordPress page registry
# (which slugs/URLs exist). `false` keeps the build fully self-contained
# (routes still work, but every URL renders from Next.js defaults).
WORDPRESS_ENABLED=true

# WPGraphQL endpoint (requires the WPGraphQL plugin on WordPress).
# Used to list registered pages and resolve URLs.
WORDPRESS_GRAPHQL_URL=https://cms.codexmattrix.com/graphql

# WordPress REST API base URL (optional fallback).
WORDPRESS_REST_URL=https://cms.codexmattrix.com/wp-json

# OPTIONAL — request timeout for CMS calls in milliseconds.
WORDPRESS_TIMEOUT_MS=8000

# --- Enquiries ("Request This Package" on /pricing) ---
# Shared secret that authenticates the Next.js server against the
# WordPress REST route `POST /wp-json/cmx/v1/enquiry` (registered by
# wordpress/cmx-enquiries.php). The browser NEVER sees this value --
# only the server-side route handler `app/api/enquiry/route.ts` does.
#
# It must EXACTLY match CMX_ENQUIRY_SECRET, which is defined in the
# site's wp-config.php (NOT in the plugin file, so the secret never
# enters this public Git repo).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORDPRESS_ENQUIRY_KEY=

# --- Reliable enquiry email (OPTIONAL but recommended) ---
# The lead is ALWAYS stored in WordPress first. Notification email is
# best-effort there, because shared hosts often block PHP mail(). When
# the WordPress send does not go out, /api/enquiry re-sends the alert
# from Vercel using, in order:
#
#   1. Resend     - used as soon as RESEND_API_KEY is set.
#   2. FormSubmit - automatic zero-config fallback. Needs no account,
#                   key or DNS record, so mail works before anyone has
#                   signed up for a provider. The FIRST send asks
#                   mcodexmattrix@gmail.com to confirm the address once;
#                   click that link and every later enquiry arrives.
#
# Recommended: set up Resend (best deliverability, SPF/DKIM handled) and
# the FormSubmit path simply stops being reached.
#
# 1. resend.com -> API Keys -> create
# 2. resend.com -> Domains -> verify codexmattrix.com (needed to send
#    from your own address; without it Resend only allows the
#    onboarding@resend.dev sender)
# 3. Add all three variables in Vercel and redeploy.
#
# Leave RESEND_API_KEY empty to use the FormSubmit fallback alone.
RESEND_API_KEY=
# Where the alert goes (must match CMX_ENQUIRY_EMAIL in wp-config.php).
ENQUIRY_EMAIL=mcodexmattrix@gmail.com
# Verified sender, e.g. CodeXmattriX <noreply@codexmattrix.com>
ENQUIRY_FROM=
# Set to "none" to disable the FormSubmit fallback completely.
ENQUIRY_MAIL_PROVIDER=

